# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated from content/projects/*.json by scripts/generate-projects.mjs
/lib/projects.generated.json

# AI image working files (large PNG originals and drop folders; web versions live in public/images/service-illustrations)
/service-illustrations/originals/
/service-illustrations/logo-drop/
/service-illustrations/hvac-logo-drop/
/service-illustrations/logo-test/
/service-illustrations/previews/
/service-illustrations/screenshots/
